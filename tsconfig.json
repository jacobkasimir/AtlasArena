{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@shared/*": ["./src/*"],
      "@phone/*": ["./phone/src/*"]
    }
  },
  "include": ["src", "phone/src", "vite.config.ts", "playwright.config.ts", "tests"]
}
